#!/usr/bin/env python3
# This file is placed in the Public Domain.


"scan bytecode for string"


import dis
import io
import os
import sys


def popen(txt):
    for line in os.popen(txt).readlines():
        print(line.rstrip())
        sys.stdout.flush()


def main():
    try:
        path, target = sys.argv[1:]
    except ValueError:
        print("scan <dir> <txt>")
        return
    for fnm in os.listdir(path):
        if not fnm.endswith(".py"):
            continue
        ffn = os.path.join(path, fnm)
        with open(ffn, "r") as src:
            SRC = src.read()
            code = compile(SRC, fnm, "exec")
            with io.StringIO() as data:
                dis.disassemble(code, file=data)
                dat = data.getvalue()
                #print(dat)
                if f"({target})" in dat:
                    print(ffn)


if __name__ == "__main__":
    main()
        